<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order/Enquire - Glenda's Bakery</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <!-- ===== HEADER ===== -->
    <header>
        <div class="logo">
            <img src="images/logo.png" alt="Glenda's Bakery Logo">
        </div>
        <nav>
            <ul>
                <li><a href="index.html">Home</a></li>
                <li><a href="about.html">About Us</a></li>
                <li><a href="services.html">Our Products</a></li>
                <li><a href="enquiry.html">Order/Enquire</a></li>
                <li><a href="contact.html">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- ===== PAGE HEADER ===== -->
    <section id="page-header">
        <h1>Place Your Order</h1>
        <p>Fill in the form below and we'll get back to you within 24 hours</p>
    </section>

    <!-- ===== ENQUIRY FORM ===== -->
    <section id="enquiry-form">
        <form action="#" method="POST">
            <!-- Personal Information -->
            <div class="form-group">
                <label for="name">Full Name *</label>
                <input type="text" id="name" name="name" placeholder="Enter your full name" required>
            </div>

            <div class="form-group">
                <label for="email">Email Address *</label>
                <input type="email" id="email" name="email" placeholder="Enter your email address" required>
            </div>

            <div class="form-group">
                <label for="phone">Phone Number *</label>
                <input type="tel" id="phone" name="phone" placeholder="Enter your phone number" required>
            </div>

            <!-- Order Type -->
            <div class="form-group">
                <label for="order-type">Type of Order *</label>
                <select id="order-type" name="order-type" required>
                    <option value="">Select an option...</option>
                    <option value="custom-cake">Custom Cake</option>
                    <option value="bulk-order">Bulk Order</option>
                    <option value="wholesale">Wholesale Enquiry</option>
                    <option value="catering">Catering Request</option>
                    <option value="general">General Enquiry</option>
                </select>
            </div>

            <!-- Event Date -->
            <div class="form-group">
                <label for="event-date">Event Date (if applicable)</label>
                <input type="date" id="event-date" name="event-date">
            </div>

            <!-- Message -->
            <div class="form-group">
                <label for="message">Your Message *</label>
                <textarea id="message" name="message" rows="6" placeholder="Tell us what you're looking for. Include flavour preferences, quantity, and any special requirements..." required></textarea>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="cta-button">Submit Enquiry</button>
        </form>
    </section>

    <!-- ===== CONTACT INFO SIDEBAR ===== -->
    <section id="quick-contact">
        <h2>Need Faster Service?</h2>
        <p><strong>Call us:</strong> 011 123 4567</p>
        <p><strong>WhatsApp:</strong> 082 123 4567</p>
        <p><strong>Email:</strong> info@glendasbakery.co.za</p>
    </section>

    <!-- ===== FOOTER ===== -->
    <footer>
        <p>&copy; 2026 Glenda's Bakery. All rights reserved.</p>
        <div class="social-links">
            <a href="#">Facebook</a> | 
            <a href="#">Instagram</a>
        </div>
    </footer>

    <script src="js/script.js"></script>
</body>
