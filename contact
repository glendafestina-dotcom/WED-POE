<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact - Glenda's Bakery</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <!-- ===== HEADER ===== -->
    <header>
        <div class="logo">
            <img src="images/logo.png" alt="Glenda's Bakery Logo">
        </div>
        <nav>
            <ul>
                <li><a href="index.html">Home</a></li>
                <li><a href="about.html">About Us</a></li>
                <li><a href="services.html">Our Products</a></li>
                <li><a href="enquiry.html">Order/Enquire</a></li>
                <li><a href="contact.html">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- ===== PAGE HEADER ===== -->
    <section id="page-header">
        <h1>Contact Us</h1>
        <p>We'd love to hear from you</p>
    </section>

    <!-- ===== CONTACT INFORMATION ===== -->
    <section id="contact-info">
        <div class="contact-details">
            <h2>Get in Touch</h2>
            <p><strong>Phone:</strong> 011 123 4567</p>
            <p><strong>WhatsApp:</strong> 082 123 4567</p>
            <p><strong>Email:</strong> info@glendasbakery.co.za</p>
            
            <h3>Operating Hours</h3>
            <p><strong>Monday - Friday:</strong> 6:00 AM - 6:00 PM</p>
            <p><strong>Saturday:</strong> 7:00 AM - 4:00 PM</p>
            <p><strong>Sunday:</strong> Closed</p>
        </div>

        <div class="contact-form">
            <h2>Send Us a Message</h2>
            <form action="#" method="POST">
                <div class="form-group">
                    <label for="contact-name">Name *</label>
                    <input type="text" id="contact-name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="contact-email">Email *</label>
                    <input type="email" id="contact-email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="contact-message">Message *</label>
                    <textarea id="contact-message" name="message" rows="5" required></textarea>
                </div>
                <button type="submit" class="cta-button">Send Message</button>
            </form>
        </div>
    </section>

    <!-- ===== LOCATION 1 (Main Store) ===== -->
    <section id="location1">
        <h2>Main Store - Soweto</h2>
        <p><strong>Address:</strong> 123 Vilakazi Street, Orlando West, Soweto, 1804</p>
        <p><strong>GPS:</strong> -26.2485° S, 27.8580° E</p>
    </section>

    <!-- ===== LOCATION 2 (Second Location) ===== -->
    <section id="location2">
        <h2>Second Location - Johannesburg</h2>
        <p><strong>Address:</strong> 45 Bree Street, Johannesburg CBD, 2001</p>
        <p><strong>GPS:</strong> -26.2041° S, 28.0473° E</p>
    </section>

    <!-- ===== FOOTER ===== -->
    <footer>
        <p>&copy; 2026 Glenda's Bakery. All rights reserved.</p>
        <div class="social-links">
            <a href="#">Facebook</a> | 
            <a href="#">Instagram</a>
        </div>
    </footer>

    <script src="js/script.js"></script>
</body>
</html>